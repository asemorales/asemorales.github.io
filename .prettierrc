{
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 150,
  "bracketSameLine": true,
  "singleAttributePerLine": false,
  "proseWrap": "preserve",
  "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/styles/global.css",
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    }
  ],
  "htmlWhitespaceSensitivity": "strict"
}
