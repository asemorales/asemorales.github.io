---
import Base from "../layouts/Base.astro";

// The bio, contact links, and a colophon. The only place the paintings are
// credited.
const contact = [
  { name: "Email", href: "mailto:hi@asemorales.com", text: "hi@asemorales.com" },
  { name: "Feed", href: "/feed.xml", text: "Atom" },
  { name: "Mathstodon", href: "https://mathstodon.xyz/@ase", text: "@ase@mathstodon.xyz", rel: "me" },
  { name: "Substack", href: "https://asemorales.substack.com", text: "asemorales.substack.com" },
  { name: "GitHub", href: "https://github.com/asemorales", text: "asemorales" },
  { name: "Bluesky", href: "https://asemorales.bsky.social/", text: "asemorales.bsky.social" },
  { name: "X", href: "https://x.com/_asemorales", text: "_asemorales" },
  { name: "LinkedIn", href: "https://www.linkedin.com/in/asemorales", text: "asemorales" },
];
const paintings = [
  { title: "Lake Lucerne", year: 1858, room: "light" },
  { title: "Among the Sierra Nevada, California", year: 1868, room: "dark" },
];
const influences = [
  { name: "Tufte CSS", href: "https://edwardtufte.github.io/tufte-css/", for: "sidenotes, the offset column, and quotes" },
  { name: "gwern.net", href: "https://gwern.net/design", for: "popovers, the contents, and design principles" },
  { name: "Wikipedia", href: "https://en.wikipedia.org/", for: "lead paragraphs, infoboxes, citations, and link colors" },
  { name: "Thinking Machines", href: "https://thinkingmachines.ai/blog/", for: "the narrow column and build-time math" },
  { name: "Normal Computing", href: "https://www.normalcomputing.com/", for: "the painting behind the header" },
  { name: "Bierstadt", href: "https://github.com/asemorales/bierstadt", for: "the rooms, palette, and paintings" },
];
---

<Base title="About" description="About Ase Morales, and how this site is made." wide preloadItalic>
  <article class="column prose-page">
    <h1 class="text-4xl">About</h1>
    <p>Research software engineer bridging logic, complexity, and cognition. Previously engineered fintech and voice AI systems for startups.</p>
    <p>These notes are on logic, complexity, and cognition.</p>

    <h2 id="contact">Contact</h2>
    <dl>
      {contact.map((c) => (
        <>
          <dt>{c.name}</dt>
          <dd>
            <a href={c.href} rel={c.rel}>
              {c.text}
            </a>
          </dd>
        </>
      ))}
    </dl>

    <h2 id="colophon">Colophon</h2>
    <p>
      Text is set in <a href="https://github.com/adobe-fonts/source-serif">Source Serif 4</a> and code in{" "}
      <a href="https://github.com/googlefonts/dm-mono">DM Mono</a>, both subset and self-hosted. Notes are written in{" "}
      <a href="https://obsidian.md/">Obsidian</a> and built into static pages by <a href="https://astro.build/">Astro</a>, with{" "}
      <a href="https://tailwindcss.com/">Tailwind CSS</a>. Math is rendered by <a href="https://www.mathjax.org/">MathJax</a> and code highlighted by{" "}
      <a href="https://shiki.style/">Shiki</a>, both when the site is built, so pages need no script to read.
    </p>
    <p>
      The site is hosted on <a href="https://pages.github.com/">GitHub Pages</a> and counts visits with <a href="https://umami.is/">Umami</a>, which
      sets no cookies. Dead links point to copies in the <a href="https://web.archive.org/">Wayback Machine</a>. The source is on{" "}
      <a href="https://github.com/asemorales/asemorales.github.io">GitHub</a> under the AGPL 3.0.
    </p>

    <h2 id="influences">Influences</h2>
    <ul>
      {influences.map((i) => (
        <li>
          <a href={i.href}>{i.name}</a>, for {i.for}
        </li>
      ))}
    </ul>

    <h2 id="paintings">Paintings</h2>
    <p>The header shows a painting by Albert Bierstadt in each room, from scans on Wikimedia Commons.</p>
    <ul>
      {paintings.map((p) => (
        <li>
          <cite>{p.title}</cite>, {p.year}, in the {p.room} room
        </li>
      ))}
    </ul>
  </article>
</Base>
