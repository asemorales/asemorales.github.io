---
import { getCollection, render } from "astro:content";
import NoteFooter from "../components/NoteFooter.astro";
import NoteTools from "../components/NoteTools.astro";
import Reading from "../components/Reading.astro";
import Base from "../layouts/Base.astro";
import { day } from "../lib/date.js";
import { GLOSSARY } from "../lib/glossary.js";
import { backlinksTo, sourceLists } from "../lib/notes";
import { description } from "../lib/summary.js";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { title, tags } = note.data;
const { Content, remarkPluginFrontmatter } = await render(note);
const written = day(note.data.date);
const updated = day(note.data.updated);
const backlinks = await backlinksTo(note);
const lists = await sourceLists(remarkPluginFrontmatter);
---

<Base
  title={title}
  description={description(note.body ?? "", title)}
  image={`/${note.id}/og.png`}
  article={{ published: written, updated, tags }}
  wide
  preloadItalic>
  <Fragment slot="rail" set:html={remarkPluginFrontmatter.toc} />
  <article class="note column">
    <h1 id="page-title" class="text-4xl">
      {title}
    </h1>
    {note.id !== GLOSSARY && (
      <p class="flex flex-wrap divide-x divide-rule font-mono text-sm text-dim *:px-2 *:first:pl-0 *:last:pr-0">
        <span>
          <time datetime={written}>{written}</time>
        </span>
        {updated !== written && (
          <span>
            Last updated <time datetime={updated}>{updated}</time>
          </span>
        )}
      </p>
    )}
    <Content />
    <NoteFooter backlinks={backlinks} lists={lists} tags={tags} />
  </article>
  <NoteTools />
  <Reading />
</Base>
