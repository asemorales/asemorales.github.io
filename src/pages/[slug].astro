---
import { getCollection, render } from "astro:content";
import NoteTools from "../components/NoteTools.astro";
import Entry from "../components/SourceEntry.astro";
import cards from "../data/cards.json";
import Base from "../layouts/Base.astro";
import { summary } from "../lib/summary.js";
import { slugify } from "../lib/slug.js";
import { linkTargets } from "../lib/wikilinks.js";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Source {
  url: string;
  text: string;
  refs: string[];
  n?: number;
  locators?: string[];
}

const { note } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(note);
const description = summary(note.body ?? "", { paragraphs: 1 })[0] ?? note.data.title;
const written = note.data.date.toISOString().slice(0, 10);
const updated = note.data.updated.toISOString().slice(0, 10);

const title = note.data.title.toLowerCase();
const backlinks = (await getCollection("notes", (n) => n.id !== note.id && (!n.data.unlisted || note.data.unlisted)))
  .filter((n) => linkTargets(n.body ?? "").some((t) => t.toLowerCase() === title))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const annotations = new Map((await getCollection("annotations")).map((a) => [a.data.url, a]));
const withAnnotations = (sources: Source[] = []) =>
  Promise.all(
    sources.map(async (s) => {
      const annotation = annotations.get(s.url);
      return {
        ...s,
        domain: new URL(s.url).hostname.replace(/^www\./, ""),
        Annotation: annotation ? (await render(annotation)).Content : null,
        blurb: (cards as Record<string, { text?: string }>)[s.url]?.text || null,
      };
    }),
  );
const lists = [
  {
    id: "references",
    title: "References",
    count: (n: number) => (n === 1 ? "1 reference" : `${n} references`),
    entries: await withAnnotations(remarkPluginFrontmatter.references as Source[]),
  },
  {
    id: "external-links",
    title: "External links",
    count: (n: number) => (n === 1 ? "1 link" : `${n} links`),
    entries: await withAnnotations(remarkPluginFrontmatter.externalLinks as Source[]),
  },
].filter((l) => l.entries.length > 0);
---

<Base title={note.data.title} description={description} image={`/${note.id}/og.png`} noindex={note.data.unlisted} wide preloadItalic>
  <article class="note column">
    <h1 class="text-4xl">{note.data.title}</h1>
    <p class="flex flex-wrap divide-x divide-rule font-mono text-sm text-dim indent-0 *:px-2 *:first:pl-0 *:last:pr-0">
      <span>
        First written <time datetime={written}>{written}</time>
      </span>
      {updated !== written && (
        <span>
          Last updated <time datetime={updated}>{updated}</time>
        </span>
      )}
    </p>
    <Content />
    <footer class="bottom">
      {backlinks.length > 0 && (
        <section aria-labelledby="see-also">
          <h2 id="see-also">
            See also
            <a href="#see-also" class="anchor" aria-label="Link to See also">
              <span class="icon icon-link" aria-hidden="true" />
            </a>
          </h2>
          <ul>
            {backlinks.map((n) => (
              <li>
                <a href={`/${n.id}/`}>{n.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {lists.map((list) => (
        <section class="sources" aria-labelledby={list.id}>
          <h2 id={list.id}>
            {list.title}
            <a href={`#${list.id}`} class="anchor" aria-label={`Link to ${list.title}`}>
              <span class="icon icon-link" aria-hidden="true" />
            </a>
          </h2>
          <details>
            <summary>{list.count(list.entries.length)}</summary>
            {list.id === "references" ? (
              <ol>
                {list.entries.map((c) => (
                  <li id={`ref-${c.n}`}>
                    <Entry {...c} />
                  </li>
                ))}
              </ol>
            ) : (
              <ul>
                {list.entries.map((c) => (
                  <li>
                    <Entry {...c} />
                  </li>
                ))}
              </ul>
            )}
          </details>
        </section>
      ))}
      {note.data.tags.length > 0 && (
        <div class="tags">
          <span class="tags-label">
            <span class="icon icon-tags" aria-hidden="true" />
            Tags
          </span>
          <ul>
            {note.data.tags.map((tag) => (
              <li>
                <a href={`/tags/${slugify(tag)}/`} class="tag">
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </footer>
  </article>
  <NoteTools />
</Base>
