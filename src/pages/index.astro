---
import { getCollection, getEntry, render } from "astro:content";
import HomeSearch from "../components/HomeSearch.astro";
import Logo from "../components/Logo.astro";
import NoteRow from "../components/NoteRow.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Base from "../layouts/Base.astro";
import { NAME, SITE_URL } from "../lib/site.js";
import { slugify } from "../lib/slug.js";
import { description } from "../lib/summary.js";

const notes = (await getCollection("notes", (n) => !n.data.unlisted)).sort((a, b) => a.data.title.localeCompare(b.data.title));
const groups = Map.groupBy(notes, (n) => n.data.tags[0]);
const order = ["logic", "complexity", "cognition", "computation"];
const rank = (tag: string) => (order.includes(tag) ? order.indexOf(tag) : order.length);
const tags = [...groups.keys()].sort((a, b) => rank(a) - rank(b) || a.localeCompare(b));
const introduction = (await getEntry("introduction", "introduction"))!;
const { Content: Introduction } = await render(introduction);
const backMatter = (await Promise.all(["to-the-reader", "acknowledgments", "glossary", "colophon"].map((id) => getEntry("notes", id)))).filter(
  (n) => n !== undefined,
);
---

<Base title={NAME} description={description(introduction.body ?? "", NAME)} wide preloadItalic>
  <link slot="head" rel="preload" href="/fonts/dm-mono.woff2" as="font" type="font/woff2" crossorigin />
  <link slot="head" rel="me" href="https://mathstodon.xyz/@ase" />
  <div class="column">
    <header class="home-title">
      <Logo class="" />
      <h1 id="page-title">
        <span class="sr-only">{NAME}</span>
        <span class="wordmark" aria-hidden="true">
          ase<span class="m">m</span>orales
        </span>
      </h1>
    </header>

    <section id="introduction" class="home-intro prose-page" aria-label="Introduction">
      <Introduction />
    </section>
    <hr class="ornament" />

    {notes.length + backMatter.length > 0 && (
      <>
        <HomeSearch />
        <nav class="home-notes" aria-labelledby="contents">
          {tags.map((tag) => (
            <section aria-labelledby={`tag-${slugify(tag)}`}>
              <h3 id={`tag-${slugify(tag)}`} class="smcp">
                <a href={`/tags/${slugify(tag)}/`}>{tag}</a>
              </h3>
              <ul>
                {groups.get(tag)!.map((n) => (
                  <NoteRow note={n} />
                ))}
              </ul>
            </section>
          ))}
          {backMatter.length > 0 && (
            <ul class="home-end">
              {backMatter.map((n) => (
                <NoteRow note={n} />
              ))}
            </ul>
          )}
          <div class="home-empty" hidden>
            <svg viewBox="0 0 120 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" aria-hidden="true">
              <path d="M60 7l5 5-5 5-5-5z" fill="currentColor" stroke="none"></path>
              <g id="flourish-half">
                <path d="M68 12c10 0 14 7 21 6 5-1 5-8 0-8-3 0-4 4-1 5"></path>
                <path d="M89 18c8-1 14-6 23-6"></path>
              </g>
              <use href="#flourish-half" transform="translate(120 0) scale(-1 1)"></use>
            </svg>
            <p>
              No notes match <q></q>.
            </p>
          </div>
        </nav>
      </>
    )}

    <hr class="ornament" />
    <figure class="epigraph">
      <blockquote>
        <p>
          I live on Earth at present, and I don’t know what I am. I know that I am not a category. I am not a thing—a noun. I seem to be a verb, an
          evolutionary process—an integral function of the universe.
        </p>
      </blockquote>
      <figcaption>Buckminster Fuller, I Seem to be a Verb</figcaption>
    </figure>

    <footer class="home-footer">
      <hr class="ornament" />
      <ul class="home-contact">
        <li class="home-feed">
          <span class="icon icon-rss" aria-hidden="true"></span>
          <label for="feed-url" class="sr-only">
            Atom feed URL
          </label>
          <input id="feed-url" type="text" readonly value={`${SITE_URL}/feed.xml`} />
        </li>
        <li class="home-theme">
          <ThemeToggle iconOnly />
        </li>
      </ul>
    </footer>
  </div>
</Base>

<script>
  import { copier } from "../client/copier";

  const field = document.querySelector<HTMLElement>(".home-feed");
  if (field && navigator.clipboard) {
    const input = field.querySelector("input")!;
    field.title = "Click to copy feed URL";
    copier(field, field.querySelector(".icon")!, "rss", () => input.value);
    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") field.click();
    });
  }
</script>
