---
import "../styles/global.css";
import LSystems from "../components/LSystems.astro";
import Popovers from "../components/Popovers.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { COLORS, NAME, SITE_URL } from "../lib/site.js";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  wide?: boolean;
  preloadItalic?: boolean;
  image?: string;
  article?: { published: string; updated: string; tags: string[] };
}

const { title, description, noindex = false, wide = false, preloadItalic = false, image = "/og.png", article } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const home = Astro.url.pathname === "/";
const fullTitle = home ? title : `${title} | ${NAME}`;
const jsonLd =
  article &&
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    image: imageUrl,
    url: canonical,
    datePublished: article.published,
    dateModified: article.updated,
    keywords: article.tags,
    author: { "@type": "Person", name: NAME, url: SITE_URL },
  }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={NAME} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={COLORS.lightPage} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={COLORS.darkPage} media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.updated} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="fediverse:creator" content="@ase@mathstodon.xyz" />
    <link rel="alternate" type="application/atom+xml" title={NAME} href="/feed.xml" />
    <slot name="head" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/source-serif-4-roman.woff2" as="font" type="font/woff2" crossorigin />
    {preloadItalic && <link rel="preload" href="/fonts/source-serif-4-italic.woff2" as="font" type="font/woff2" crossorigin />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}

    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>

    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://cloud.umami.is/script.js"
        data-website-id="aeeab31a-d067-4d0a-9c78-5372e12b938f"
        data-domains="asemorales.com"
      />
    )}
    <noscript>
      <style is:inline>
        .theme-toggle,
        .home-theme {
          display: none !important;
        }
      </style>
    </noscript>
  </head>

  <body class:list={["mx-auto flex min-h-dvh flex-col px-4 py-6 sm:px-8", wide ? "max-w-[96rem]" : "max-w-6xl"]}>
    <a href="#page-title" class="skip-link">
      Skip to content
    </a>
    <div class="page">
      {!home && (
        <div class="rail">
          <div>
            <nav class="site-nav" aria-label="Site">
              <a href="/" class="site-home">
                <span class="icon icon-home" aria-hidden="true"></span>
                Home
              </a>
              <ThemeToggle />
            </nav>
            <slot name="rail" />
          </div>
        </div>
      )}
      <main class:list={["mb-12 @container", home ? "mt-22" : "min-[1200px]:mt-22"]}>
        <slot />
      </main>
    </div>
    <LSystems />
    <Popovers />
  </body>
</html>
