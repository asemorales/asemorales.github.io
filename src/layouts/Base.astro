---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import Popovers from "../components/Popovers.astro";
import RoomToggle from "../components/RoomToggle.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  // Notes need room for the contents on the left and sidenotes on the right.
  wide?: boolean;
  // Pages with italics, such as notes, load the italic face early. Otherwise
  // the browser finds it needs the face only after layout, and italics paint
  // in the fallback before swapping in.
  preloadItalic?: boolean;
  // Notes pass their own social image. Other pages share the site's.
  image?: string;
}

const { title, description, noindex = false, wide = false, preloadItalic = false, image = "/og.png" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const fullTitle = Astro.url.pathname === "/" ? title : `${title} | Ase Morales`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f2ecdf" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191612" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="fediverse:creator" content="@ase@mathstodon.xyz" />
    <link rel="alternate" type="application/atom+xml" title="Ase Morales" href="/feed.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/source-serif-4-roman.woff2" as="font" type="font/woff2" crossorigin />
    {preloadItalic && <link rel="preload" href="/fonts/source-serif-4-italic.woff2" as="font" type="font/woff2" crossorigin />}

    <!-- Apply the reader's room before the first paint. Without a choice, the room follows the system. -->
    <script is:inline>
      try {
        const room = localStorage.getItem("room");
        if (room === "light" || room === "dark") document.documentElement.dataset.room = room;
      } catch {
        // Storage is blocked. Follow the system.
      }
    </script>

    {import.meta.env.PROD && <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id="aeeab31a-d067-4d0a-9c78-5372e12b938f" />}
  </head>

  <body class:list={["mx-auto px-4 py-6 sm:px-8", wide ? "max-w-[96rem]" : "max-w-6xl"]}>
    <header class="relative mb-12 flex h-10 items-center justify-between gap-4">
      <a href="/" class="text-ink" aria-label="Ase Morales, home">
        <Logo />
      </a>
      <RoomToggle />
    </header>
    <main class="@container">
      <slot />
    </main>
    <Popovers />
  </body>
</html>
