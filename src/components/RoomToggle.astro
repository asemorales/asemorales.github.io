---
interface Props {
  iconOnly?: boolean;
}

const { iconOnly = false } = Astro.props;
---

<!-- Must match the button built in src/lib/rehype-sections.js. -->
<button type="button" class="room-toggle">
  <span class="icon icon-sun" aria-hidden="true"></span>
  <span class="icon icon-moon" aria-hidden="true"></span>
  <span class:list={{ "sr-only": iconOnly }}>Toggle theme</span>
  <span class="sr-only" aria-live="polite">
    (<span data-label>auto</span>)
  </span>
</button>

<script>
  const ROOMS = ["auto", "light", "dark"] as const;
  type Room = (typeof ROOMS)[number];

  const buttons = document.querySelectorAll<HTMLButtonElement>(".room-toggle");
  const root = document.documentElement;

  const current = (): Room => (root.dataset.room === "light" || root.dataset.room === "dark" ? root.dataset.room : "auto");

  function show(room: Room) {
    for (const button of buttons) {
      button.querySelector("[data-label]")!.textContent = room;
      button.title = `Theme: ${room}`;
    }
  }

  function apply(room: Room) {
    if (room === "auto") delete root.dataset.room;
    else root.dataset.room = room;
    show(room);
    try {
      if (room === "auto") localStorage.removeItem("room");
      else localStorage.setItem("room", room);
    } catch {}
  }

  show(current());
  for (const button of buttons) button.addEventListener("click", () => apply(ROOMS[(ROOMS.indexOf(current()) + 1) % ROOMS.length]));
</script>
