---
---

<div id="lsystems" hidden class="mt-auto -mb-6 [--desktop:0] md:[--desktop:1] print:hidden" aria-hidden="true">
  <svg class="block h-56 w-full fill-frame stroke-frame"></svg>
</div>

<script>
  import { GENERATIONS, KINDS, TREE, between, choose, reached, spots, sprout } from "../lib/lsystem.js";

  type Plant = {
    path: SVGPathElement;
    layers: string[];
    generation: number;
    due: number;
  };

  const STEP = 300;

  const root = document.getElementById("lsystems")!;
  root.hidden = false;
  const svg = root.querySelector("svg")!;
  const { width, height } = svg.getBoundingClientRect();
  const desktop = getComputedStyle(root).getPropertyValue("--desktop") === "1";
  const free = spots(desktop ? 20 : 10, width);
  const maxTrees = desktop ? 8 : 3;

  let trees = 0;
  let growing: Plant[] = [];
  let concurrent = between(1, 3);
  let nextStart = 0;
  let frame = 0;

  const finished = () => !free.length && !growing.length;

  function start() {
    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    svg.append(path);
    const [x] = free.splice(between(0, free.length - 1), 1);
    const kind = choose(trees < maxTrees ? KINDS : KINDS.filter((k) => k !== TREE));
    if (kind === TREE) trees++;
    growing.push({ path, layers: sprout(kind, x, height, width), generation: 0, due: 0 });
  }

  function step(plant: Plant) {
    plant.path.setAttribute("d", (plant.path.getAttribute("d") ?? "") + plant.layers[plant.generation++]);
  }

  function complete() {
    for (const plant of growing) while (plant.generation < GENERATIONS) step(plant);
    growing = [];
  }

  function tick(now: number) {
    if (free.length && growing.length < concurrent && now >= nextStart) {
      start();
      nextStart = now + between(1000, 3000);
    }
    for (const plant of growing) {
      if (now >= plant.due) {
        step(plant);
        plant.due = now + STEP;
      }
    }
    const unfinished = growing.filter((plant) => plant.generation < GENERATIONS);
    if (unfinished.length < growing.length) concurrent = between(1, 3);
    growing = unfinished;
    frame = finished() ? 0 : requestAnimationFrame(tick);
  }

  function update() {
    if (finished()) return;
    const ready = reached(scrollY, innerHeight, document.documentElement.scrollHeight);
    if (!ready) {
      cancelAnimationFrame(frame);
      frame = 0;
    } else if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      while (free.length) start();
      complete();
    } else if (!frame) {
      frame = requestAnimationFrame(tick);
    }
  }

  for (let i = desktop ? between(3, 4) : between(1, 2); i > 0; i--) start();
  complete();

  addEventListener("scroll", update, { passive: true });
  addEventListener("resize", update);
  new ResizeObserver(update).observe(document.documentElement);
</script>
