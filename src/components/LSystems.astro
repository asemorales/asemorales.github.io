---
import { getCollection } from "astro:content";
import { day } from "../lib/date.js";

const tended = (await getCollection("notes", (note) => !note.data.unlisted)).map((note) => day(note.data.updated)).join(" ");
---

<div
  id="lsystems"
  hidden
  class="mt-auto -mb-6 cursor-pointer [--desktop:0] [--plants:10] [--trees:3] sm:[--plants:13] sm:[--trees:4] md:[--desktop:1] md:[--plants:14] md:[--trees:5] lg:[--plants:17] lg:[--trees:7] xl:[--plants:20] xl:[--trees:8] print:hidden"
  data-tended={tended}
  aria-hidden="true">
  <svg class="block h-56 w-full fill-frame stroke-frame">
    <g class="plants"></g>
    <g class="wildlife" pointer-events="none"></g>
  </svg>
</div>

<script>
  const root = document.getElementById("lsystems")!;
  root.hidden = false;
  new IntersectionObserver(
    async ([entry], observer) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      const { grow } = await import("../client/garden");
      grow(root);
    },
    { rootMargin: "100% 0px" },
  ).observe(root);
</script>
