---
import favicon from "../../public/favicon.svg?raw";

interface Props {
  class?: string;
}

const { class: className = "h-7" } = Astro.props;
const glyph = favicon.match(/<g[\s\S]*<\/g>/)![0];
---

<svg class:list={[className, "w-auto fill-current"]} viewBox="7.4 14.7 55.8 40.3" aria-hidden="true" set:html={glyph} />
