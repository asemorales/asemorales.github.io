---
---

<script>
  import type { Card } from "../types";
  import { fill } from "../client/popover-card";
  import { domain } from "../lib/links.js";

  const DELAY = 300;
  const LINGER = 200;
  let data: Promise<Record<string, Card>> | null = null;
  let pop: HTMLElement | null = null;
  let current: HTMLElement | null = null;
  let openTimer: number | undefined;
  let closeTimer: number | undefined;

  const load = (): Promise<Record<string, Card>> =>
    (data ??= fetch("/popovers.json")
      .then((r) => (r.ok ? r.json() : {}))
      .catch(() => ({})));

  function key(a: HTMLElement) {
    if (!(a instanceof HTMLAnchorElement)) return a.dataset.card!;
    const url = new URL(a.href, location.href);
    if (url.origin !== location.origin) return url.href;
    return url.hash ? `${url.pathname}${decodeURIComponent(url.hash)}` : url.pathname;
  }

  function element() {
    if (pop) return pop;
    pop = document.createElement("div");
    pop.id = "link-popover";
    pop.className = "link-popover";
    pop.popover = "manual";
    pop.setAttribute("role", "tooltip");
    pop.addEventListener("pointerenter", () => clearTimeout(closeTimer));
    pop.addEventListener("pointerleave", () => scheduleClose());
    document.body.append(pop);
    return pop;
  }

  function place(el: HTMLElement, a: HTMLElement) {
    const r = a.getClientRects()[0] ?? a.getBoundingClientRect();
    const w = el.offsetWidth;
    const h = el.offsetHeight;
    const beside = a.closest(".note-graph") && r.left - w - 6 >= 8;
    const left = beside ? r.left - w - 6 : Math.min(Math.max(8, r.left), innerWidth - w - 8);
    const above = r.top - h - 6;
    const top = beside ? Math.max(8, Math.min(r.top, innerHeight - h - 8)) : above >= 8 ? above : r.bottom + 6;
    el.style.left = `${left}px`;
    el.style.top = `${top}px`;
  }

  function citation(a: HTMLAnchorElement, data: Record<string, Card>): Card | undefined {
    const entry = document.getElementById(decodeURIComponent(a.hash.slice(1)));
    if (!entry) return;
    const source = entry.querySelector<HTMLAnchorElement>(":scope > a[href]");
    if (!source) return { title: entry.querySelector(":scope > .source-text")!.textContent!.trim(), paragraphs: [] };
    const card = data[key(source)];
    const locator = entry.querySelector(":scope > .locators")?.textContent;
    const meta = [...(card?.meta ?? []), locator].filter((m): m is string => !!m);
    return { title: card?.title ?? source.textContent!.trim(), meta, paragraphs: card?.paragraphs ?? [], href: source.href };
  }

  async function open(a: HTMLElement) {
    const data = await load();
    const card = a.closest(".cite-ref") ? citation(a as HTMLAnchorElement, data) : data[key(a)];
    if (!card || current !== a) return;
    const el = element();
    fill(el, card, a);
    if (!el.matches(":popover-open")) el.showPopover();
    const body = el.querySelector<HTMLElement>(".popover-body");
    body?.classList.toggle("clipped", body.scrollHeight > body.clientHeight);
    place(el, a);
    a.setAttribute("aria-describedby", el.id);
  }

  function close() {
    clearTimeout(openTimer);
    clearTimeout(closeTimer);
    current?.removeAttribute("aria-describedby");
    current = null;
    if (pop?.matches(":popover-open")) pop.hidePopover();
  }

  function scheduleClose() {
    clearTimeout(closeTimer);
    closeTimer = window.setTimeout(close, LINGER);
  }

  function start(a: HTMLElement, delay: number) {
    if (a === current) return clearTimeout(closeTimer);
    close();
    current = a;
    load();
    openTimer = window.setTimeout(() => open(a), delay);
  }

  const SKIP = ".anchor, .sidenote-ref, .backrefs, .link-popover, mjx-container";
  function linkFrom(target: EventTarget | null, tapped = false) {
    const a = (target as Element | null)?.closest?.<HTMLElement>("main a[href], main [data-card]");
    return a && !a.closest(SKIP) && !(tapped && a.closest(".cite-ref")) ? a : null;
  }

  document.addEventListener("pointerover", (e) => {
    if (e.pointerType !== "mouse") return;
    const a = linkFrom(e.target);
    if (a) start(a, DELAY);
  });
  document.addEventListener("pointerout", (e) => {
    if (e.pointerType !== "mouse") return;
    const a = linkFrom(e.target);
    if (a && a === current && !a.contains(e.relatedTarget as Node)) {
      clearTimeout(openTimer);
      scheduleClose();
    }
  });
  document.addEventListener("focusin", (e) => {
    const a = linkFrom(e.target);
    if (a?.matches(":focus-visible")) start(a, 0);
  });
  document.addEventListener("focusout", (e) => {
    if (linkFrom(e.target) === current) close();
  });
  let drawer: HTMLDialogElement | null = null;
  function drawerElement() {
    if (drawer) return drawer;
    const d = document.createElement("dialog");
    d.className = "link-drawer";
    d.tabIndex = -1;
    d.setAttribute("aria-label", "Link preview");
    d.addEventListener("click", (e) => {
      if (e.target === d) d.close();
    });
    document.body.append(d);
    return (drawer = d);
  }

  function openDrawer(a: HTMLElement, card: Card) {
    const d = drawerElement();
    const content = document.createElement("div");
    content.className = "drawer-content";
    fill(content, card, a, false);
    const close = document.createElement("button");
    close.type = "button";
    close.className = "drawer-close";
    close.setAttribute("aria-label", "Close preview");
    close.innerHTML = '<span class="icon icon-x" aria-hidden="true"></span>';
    close.addEventListener("click", () => d.close());
    d.replaceChildren(close, content);
    if (a instanceof HTMLAnchorElement) {
      const go = document.createElement("a");
      go.className = "drawer-go";
      go.href = a.href;
      const url = new URL(a.href, location.href);
      go.textContent =
        url.origin === location.origin
          ? url.hash && url.pathname === location.pathname
            ? "Go to section"
            : "Read note"
          : `Open ${domain(url.href)}`;
      go.addEventListener("click", () => d.close());
      d.append(go);
    }
    d.showModal();
    d.focus();
    content.scrollTop = 0;
  }

  let touch = false;
  document.addEventListener(
    "pointerdown",
    (e) => {
      touch = e.pointerType !== "mouse";
      if (touch && linkFrom(e.target, true)) load();
    },
    { passive: true },
  );
  document.addEventListener("click", async (e) => {
    if (!touch || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a = linkFrom(e.target, true);
    if (!a) return;
    e.preventDefault();
    const card = (await load())[key(a)];
    if (card) openDrawer(a, card);
    else if (a instanceof HTMLAnchorElement) location.href = a.href;
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") close();
  });
  addEventListener(
    "scroll",
    () => {
      if (pop?.matches(":popover-open")) close();
    },
    { passive: true },
  );
</script>
