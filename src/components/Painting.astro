---
// A painting behind the header band, one per room, with no caption. The
// paintings are credited at the foot of the homepage. CSS picks the room's painting, and
// a browser downloads only the background it shows, so the other room's never
// loads. Each comes as AVIF or WebP, at two widths.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import lucerne from "../assets/paintings/bierstadt-lake-lucerne.jpg";
import sierra from "../assets/paintings/bierstadt-sierra-nevada.jpg";

interface Props {
  class?: string;
}

async function imageSet(src: ImageMetadata, width: number) {
  const [avif, webp] = await Promise.all([getImage({ src, width, format: "avif" }), getImage({ src, width, format: "webp" })]);
  return `image-set(url("${avif.src}") type("image/avif"), url("${webp.src}") type("image/webp"))`;
}

const vars = {
  "--painting-light": await imageSet(lucerne, 1600),
  "--painting-light-small": await imageSet(lucerne, 800),
  "--painting-dark": await imageSet(sierra, 1600),
  "--painting-dark-small": await imageSet(sierra, 800),
};
---

<div class:list={["painting", Astro.props.class]} style={vars} aria-hidden="true"></div>
