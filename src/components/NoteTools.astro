---
---

<script>
  function tools(block: HTMLElement) {
    let bar = block.querySelector<HTMLElement>(":scope > .block-tools");
    if (!bar) {
      bar = document.createElement("div");
      bar.className = "block-tools";
      block.append(bar);
    }
    return bar;
  }

  function setIcon(el: Element, name: string) {
    el.className = el.className.replace(/\bicon-\S+/, `icon-${name}`);
  }

  function button(block: HTMLElement, icon: string, title: string) {
    const b = document.createElement("button");
    b.type = "button";
    b.title = title;
    b.setAttribute("aria-label", title);
    const i = document.createElement("span");
    i.className = `icon icon-${icon}`;
    i.setAttribute("aria-hidden", "true");
    b.append(i);
    tools(block).append(b);
    return b;
  }

  function copier(target: HTMLElement, icon: Element, rest: string, getText: () => string) {
    let timer: number | undefined;
    target.addEventListener("click", async (e) => {
      e.preventDefault();
      let ok = true;
      try {
        await navigator.clipboard.writeText(getText());
      } catch {
        ok = false;
      }
      setIcon(icon, ok ? "check" : "x");
      target.dataset.copied = ok ? "true" : "false";
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        setIcon(icon, rest);
        delete target.dataset.copied;
      }, 1500);
    });
  }

  function addCopy(block: HTMLElement) {
    const b = button(block, "copy", "Copy code");
    copier(b, b.firstElementChild!, "copy", () => (block.querySelector("pre")?.textContent ?? "").replace(/\n$/, ""));
  }

  function addMath(block: HTMLElement) {
    const tex = block.dataset.tex;
    const math = block.querySelector<HTMLElement>("mjx-container");
    if (!tex || !math) return;
    if (navigator.clipboard) {
      const copy = button(block, "copy", "Copy LaTeX");
      copier(copy, copy.firstElementChild!, "copy", () => tex);
    }
    const b = button(block, "code", "Show LaTeX source");
    b.setAttribute("aria-pressed", "false");
    let source: HTMLElement | null = null;
    b.addEventListener("click", () => {
      if (!source) {
        source = document.createElement("pre");
        source.className = "astro-code tex-source";
        source.tabIndex = 0;
        const code = document.createElement("code");
        code.textContent = tex;
        source.append(code);
        source.hidden = true;
        math.after(source);
      }
      const showing = !source.hidden;
      source.hidden = showing;
      math.hidden = !showing;
      b.setAttribute("aria-pressed", String(!showing));
      b.title = showing ? "Show LaTeX source" : "Show rendered math";
      b.setAttribute("aria-label", b.title);
      setIcon(b.firstElementChild!, showing ? "code" : "sigma");
    });
  }

  function addLink(anchor: HTMLAnchorElement) {
    anchor.title = "Copy link to section";
    anchor.setAttribute("aria-label", anchor.getAttribute("aria-label")!.replace(/^Link/, "Copy link"));
    copier(anchor, anchor.querySelector(".icon")!, "link", () => anchor.href);
  }

  if (navigator.clipboard) {
    for (const block of document.querySelectorAll<HTMLElement>(".note .code-block")) addCopy(block);
    for (const a of document.querySelectorAll<HTMLAnchorElement>(".note a.anchor")) addLink(a);
  }
  for (const block of document.querySelectorAll<HTMLElement>(".note .math-block")) addMath(block);

  document.addEventListener("pointerdown", (e) => {
    if (e.pointerType !== "touch") return;
    const target = (e.target as Element).closest<HTMLElement>(".code-block, .math-block");
    for (const block of document.querySelectorAll(".note .show")) if (!block.contains(target)) block.classList.remove("show");
    target?.classList.add("show");
  });

  function reveal(hash: string) {
    const target = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
    const details = target?.closest<HTMLDetailsElement>(".note details:not([open])");
    if (details && !details.querySelector("summary")!.contains(target)) details.open = true;
  }
  document.addEventListener("click", (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>("a[href^='#']");
    if (a) reveal(a.hash);
  });
  if (location.hash) {
    reveal(location.hash);
    document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView();
  }

  function equation(target: EventTarget | null) {
    const href = (target as Element | null)?.closest?.("a")?.getAttribute("href");
    if (!href?.startsWith("#mjx-eqn")) return null;
    return document.getElementById(decodeURIComponent(href.slice(1)))?.closest<HTMLElement>(".math-block") ?? null;
  }
  let pinned: HTMLElement | null = null;
  document.addEventListener("pointerover", (e) => equation(e.target)?.classList.add("referenced"));
  document.addEventListener("pointerout", (e) => {
    const eq = equation(e.target);
    if (eq && eq !== pinned && equation(e.relatedTarget) !== eq) eq.classList.remove("referenced");
  });
  document.addEventListener("click", (e) => {
    const eq = equation(e.target);
    if (pinned && pinned !== eq) pinned.classList.remove("referenced");
    pinned = eq;
    eq?.classList.add("referenced");
  });

  function sidenote(target: EventTarget | null) {
    const el = (target as Element | null)?.closest?.(".note .sidenote-number, .note .sidenote-ref, .note .sidenote");
    if (!el) return null;
    const label = el.matches(".sidenote-ref")
      ? document.getElementById(decodeURIComponent(el.querySelector("a")!.hash.slice(1)))
      : el.matches(".sidenote")
        ? el.previousElementSibling?.previousElementSibling
        : el;
    if (!label?.matches(".sidenote-number")) return null;
    const ref = CSS.escape(label.id);
    return [label, label.nextElementSibling!.nextElementSibling!, ...document.querySelectorAll(`.note .sidenote-ref:has(a[href="#${ref}"])`)];
  }
  function highlight(els: Element[] | null, on: boolean) {
    for (const el of els ?? []) el.classList.toggle("highlighted", on);
  }
  let pinnedNote: Element[] | null = null;
  document.addEventListener("pointerover", (e) => highlight(sidenote(e.target), true));
  document.addEventListener("pointerout", (e) => {
    const note = sidenote(e.target);
    if (note && note[0] !== pinnedNote?.[0] && sidenote(e.relatedTarget)?.[0] !== note[0]) highlight(note, false);
  });
  document.addEventListener("click", (e) => {
    if ((e.target as Element).matches(".note .margin-toggle")) return;
    const note = sidenote(e.target);
    if (pinnedNote && pinnedNote[0] !== note?.[0]) highlight(pinnedNote, false);
    pinnedNote = note;
    highlight(note, true);
  });

  let closed: HTMLDetailsElement[] = [];
  addEventListener("beforeprint", () => {
    closed = [...document.querySelectorAll<HTMLDetailsElement>(".note details:not([open])")];
    for (const d of closed) d.open = true;
  });
  addEventListener("afterprint", () => {
    for (const d of closed) d.open = false;
  });
</script>
