{
  "name": "asemorales.com",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "sync": "node --env-file-if-exists=.env scripts/books.js && node --env-file-if-exists=.env scripts/sync.js && node scripts/build-cards.js && prettier --write --log-level warn src/data/cards.json src/data/books.json src/data/library.json && markdownlint-cli2 --fix",
    "cards": "node scripts/build-cards.js",
    "archive": "node scripts/archive-links.js",
    "fonts": "sh scripts/fonts.sh",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint . && markdownlint-cli2 && npm run lint:prose && astro check",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "lint:links": "docker run --rm -v \"$PWD/dist:/dist:ro\" lycheeverse/lychee:0.24.2 --offline --no-progress --root-dir /dist --index-files index.html /dist",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs && lhci autorun --config=lighthouserc.cjs --collect.settings.preset=desktop",
    "check": "npm run lint && npm run test && npm run build && npm run lint:html && npm run lint:links && npm run test:e2e",
    "typos": "python3 scripts/build-typos.py",
    "lint:prose": "vale docs AGENTS.md README.md NOTICE.md src scripts tests/unit tests/e2e *.mjs *.js *.cjs *.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@mathjax/src": "^4.1.3",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "entities": "^9.0.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-html": "^9.0.6",
    "hastscript": "^9.0.3",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@vvago/vale": "^3.25.1",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "html-validate": "^11.4.0",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
